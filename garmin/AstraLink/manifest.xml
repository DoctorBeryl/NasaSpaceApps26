<?xml version="1.0"?>
<!-- AstraLink: sends live readings from a Garmin Forerunner 255 to AstraSight (docs/GARMIN.md) -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="527c7b8a35ae441fbd16a49636d0c27c" type="watch-app" name="@Strings.AppName"
        entry="AstraLinkApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.3.0">
        <iq:products>
            <iq:product id="fr255"/>
            <iq:product id="fr255m"/>
            <iq:product id="fr255s"/>
            <iq:product id="fr255sm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Sensor"/>
            <iq:uses-permission id="SensorHistory"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
