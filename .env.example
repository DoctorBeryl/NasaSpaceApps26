# Optional: the shared team key in server/elevenlabs-key.js is used if this is blank.
ELEVENLABS_API_KEY=
# Optional: any voice ID from your ElevenLabs voice library (default: Sarah — free-tier premade voices only)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
PORT=8000
# VEGA AI (Qwen 2.5 via local Ollama): /api/ai/* and the HUD command box (/api/chat) both use this model.
# Install Ollama, then: ollama pull qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Body-map triage on report.html (/api/ai/triage) uses a medical model, Google's MedGemma.
# ollama pull medgemma1.5:4b   (without it, triage falls back to OLLAMA_MODEL)
OLLAMA_MED_MODEL=medgemma1.5:4b
# Face sign-in + Firebase Auth (docs/AUTH.md). Leave blank to run face sign-in in local mode.
# Web app config: Firebase console > Project settings > Your apps (these values are public by design)
FIREBASE_API_KEY=AIzaSyCbfssOIZ20erZ3lKAUGEfl9OMYuFT0g64
FIREBASE_PROJECT_ID=nasa-space-app-challange
FIREBASE_APP_ID=1:75019919525:web:b8319531e9afb7a7316d4c
# Service account key: Project settings > Service accounts > Generate new private key.
# Save the JSON in the repo root (the default *firebase-adminsdk*.json name is gitignored) and point to it:
# FIREBASE_SERVICE_ACCOUNT=./your-project-firebase-adminsdk-xxxxx.json
# Optional: 0.3 (strict) to 0.7 (lenient); default 0.5. Self-host the models for offline demos.
# FACE_MATCH_THRESHOLD=0.5
# FACE_MODEL_URL=https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.15/model/
